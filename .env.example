# PostgreSQL 连接配置（复制为 .env 并按需修改；.env 不入库）
DB_HOST=192.168.1.3
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=inter
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# 雪花 ID 服务地址
SNOWFLAKE_ID_URL=http://192.168.1.3:8088

# 日志级别
SERVICE_NAME=inter-info
ENVIRONMENT=local
LOG_LEVEL=INFO

# 日志目录（容器内持久化路径）
LOG_DIR=/var/logs/inter
